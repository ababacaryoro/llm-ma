# Copier ce fichier en `.env` (avec le point) et renseigner les cles.
# `.env` est ignore par git : ne jamais le partager.

# --- Fournisseur LLM : mistral | openai | ollama ---
LLM_PROVIDER=mistral

# Mistral (defaut) : compte gratuit sur https://console.mistral.ai, onglet "Cles API"
MISTRAL_API_KEY=

# OpenAI : uniquement si une cle est fournie par le formateur
OPENAI_API_KEY=

# --- Observabilite Langfuse (recommande, utilise au jour 2) ---
# Projet cree en region EU sur https://cloud.langfuse.com, Settings > API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Reglages optionnels ---
# LLM_MODEL=mistralai:mistral-small-latest   # surcharge le modele par defaut du fournisseur
# LLM_MAX_TOKENS=1024                        # borne dure par reponse (garde-fou budget)
# RAG_CORPUS=loi-repost                      # corpus du RAG : loi-repost | orion | formation
